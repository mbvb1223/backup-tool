{
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "aws/aws-sdk-php": "^3.0",
        "symfony/lock": "^7.4",
        "monolog/monolog": "^3.0",
        "ext-zlib": "*"
    },
    "require-dev": {
        "deployer/deployer": "^8.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "BackupTool\\": "src/"
        }
    },
    "scripts": {
        "pre-autoload-dump": "Aws\\Script\\Composer\\Composer::removeUnusedServices"
    },
    "extra": {
        "aws/aws-sdk-php": ["S3"]
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        }
    }
}
